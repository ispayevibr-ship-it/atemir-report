{
  "name": "atemir-report",
  "version": "1.1.28",
  "description": "Отчётность по объектам ТОО А-Темир Строй",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "electron": "36.9.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "kz.atemirstroy.report",
    "productName": "А-Темир Строй Отчёт",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ispayevibr-ship-it",
        "repo": "atemir-report-updates",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "A-Temir-Stroy-Report-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
